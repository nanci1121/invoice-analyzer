{
  "name": "invoice-analyzer",
  "version": "1.0.0",
  "description": "Analizador de facturas con KPI y gráficas (Electron + React + SQLite)",
  "main": "electron/main.js",
  "author": "Venancio <venancio@example.com>",
  "scripts": {
    "dev": "concurrently \"npm run vite\" \"npm run electron\"",
    "vite": "vite",
    "electron": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "build:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "build:all": "npm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "com.invoiceanalyzer.app",
    "productName": "Invoice Analyzer",
    "directories": {
      "output": "dist-electron"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^40.0.0",
    "electron-builder": "^26.5.0",
    "tailwindcss": "^3.4.0",
    "vite": "^7.3.1",
    "wait-on": "^7.2.0"
  }
}
